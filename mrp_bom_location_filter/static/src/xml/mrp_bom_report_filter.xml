<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <!-- 19.0: depo seçici yalnız Tahmin (forecast) modunda ve stok sütunları da
         yalnız o modda görünüyor; konum filtresi depo seçicinin önüne alındı. -->
    <t t-name="mrp_bom_location_filter.LocationFilterInherit" t-inherit="mrp.BomOverviewControlPanel" t-inherit-mode="extension">
        <xpath expr="//t[@t-if='props.warehouses.length &gt; 1']" position="before">
            <t t-if="locationState.locations.length">
                <Dropdown items="locationItems">
                    <button class="btn btn-secondary o-dropdown-caret">
                        <span class="fa fa-map-marker"/> <t t-out="selectedLocationName"/>
                    </button>
                </Dropdown>
            </t>
        </xpath>
    </t>
</templates>
